# Python bytecode cache (server/ is the only Python in the repo)
__pycache__/
*.py[cod]

# Local virtualenv for the IB proxy (see server/README.md)
server/.venv/
.venv/

# Shioaji writes a runtime log next to the process
shioaji.log

# Local SinoPac keys written by start-live.command — never commit
server/.env
